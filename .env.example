# ========================================
# Self-Hosted Analytics Stack - Reference Env File
# ========================================
#
# Reference ONLY. The supported install path is:
#
#     ./install.sh
#
# install.sh generates a real .env with a random Postgres password and
# random n8n encryption key, chmod 600. Do not copy this file to .env
# and edit it by hand — you will get a stack with the placeholder
# password and compose will refuse to start (POSTGRES_PASSWORD:? is set
# to fail loud on unset secrets).
#
# This file is kept around so the canonical set of env vars is visible
# in one place without having to read install.sh.
#
# POSTGRES_USER is effectively not customizable: init-db.sql and the
# backup/restore scripts derive ownership from whatever value you pass,
# but the example keeps 'admin' because every default in the stack is
# tuned to it.
# ========================================

# ========================================
# PostgreSQL Database Configuration
# ========================================

# Database host (container name)
# Default: postgres (for new installations)
# Note: If migrating from older version, you may have postgres_main
POSTGRES_HOST=postgres

# Database port
POSTGRES_PORT=5432

# Database user. Default: admin. install.sh always sets this to admin.
POSTGRES_USER=admin

# Database password. install.sh generates a real one via openssl rand.
# The placeholder below is intentionally invalid — compose will refuse
# to start if POSTGRES_PASSWORD is unset or left as the placeholder.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# n8n encryption key for credential storage. install.sh generates this
# via 'openssl rand -hex 32'. Required when n8n uses Postgres (our
# default). Do NOT reuse POSTGRES_PASSWORD — these are separate secrets.
N8N_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET

# Compose project name. Scopes volume and network names so multiple
# instances don't collide. Default: sha.
COMPOSE_PROJECT_NAME=sha

# ========================================
# Database Names
# ========================================

# Main analytics database (for your data)
POSTGRES_DB=analytics

# n8n workflow automation database
POSTGRES_N8N_DB=n8n

# Metabase analytics app database
POSTGRES_METABASE_DB=metabase

# Prefect workflow orchestration database
POSTGRES_PREFECT_DB=prefect

# ========================================
# Timezone Configuration
# ========================================

# Timezone for all services
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# ========================================
# Optional: External Access Configuration
# ========================================
# Uncomment and configure these if exposing services via domain/tunnel

# n8n external access
#N8N_PROTOCOL=https
#N8N_HOST=n8n.yourdomain.com
#WEBHOOK_URL=https://n8n.yourdomain.com

# Metabase external access
#MB_SITE_URL=https://metabase.yourdomain.com

# Prefect external access
#PREFECT_API_URL=https://prefect.yourdomain.com/api

# ========================================
# SECURITY NOTES
# ========================================
#
# Default Configuration (Secure):
# - All services bind to localhost (127.0.0.1) only
# - Not accessible from network or internet
# - Safe for local development and personal use
#
# Before Exposing to Internet:
# - Change POSTGRES_PASSWORD to a strong password
# - Use HTTPS (set up reverse proxy or tunnel)
# - Review SECURITY.md for detailed guidance
#
# For Remote Access Options:
# - SSH Tunnel (most secure)
# - Cloudflare Tunnel (easy, free)
# - Tailscale (private network)
# - Reverse Proxy with SSL (advanced)
#
# See SECURITY.md for complete security guide
#
# ========================================